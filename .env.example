# Used by docker-compose.yml to configure the db/redis/api services.
# Copy to .env and adjust as needed: cp .env.example .env

POSTGRES_USER=shopflow
POSTGRES_PASSWORD=shopflow
POSTGRES_DB=shopflow
POSTGRES_PORT=5432

REDIS_PORT=6379

APP_ENV=local
APP_PORT=8000

# --- Auth / JWT (added in P3) ---
# REQUIRED. No default — the app refuses to boot without it.
# Generate a strong random value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY= YYU7UJLDKC6Bpdc0xj_I6QGxS3CtlfsU2RW0MAX2NO9hNXGsbXFdoHXXGK76Rmk_

# Optional — shown with their defaults; override only if needed.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth cookies. Set COOKIE_SECURE=false for local plain-HTTP dev; keep true in prod.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=          # leave unset for host-only cookies

# Rate limiting (per minute)
RATE_LIMIT_PUBLIC_PER_MINUTE=100
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=1000
